# Optional. Miki runs fully without any of these.
# Set ONE of the following to enable server transcription of voice recordings.

# OpenAI (or any OpenAI-compatible speech-to-text API)
# TRANSCRIPTION_API_KEY=sk-...
# TRANSCRIPTION_MODEL=whisper-1

# A local Whisper server, so audio never leaves your machine (e.g. Speaches / faster-whisper-server)
# TRANSCRIPTION_API_BASE=http://localhost:8000/v1
# TRANSCRIPTION_MODEL=Systran/faster-whisper-small

# Max upload size in bytes (default 25 MB; Vercel functions cap requests at ~4.5 MB)
# TRANSCRIPTION_MAX_BYTES=26214400
